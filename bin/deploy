#!/usr/bin/env bash

# Safe deploy to GitHub Pages from a source branch

SRC_BRANCH="source"
DEPLOY_BRANCH="gh-pages"

# Exit on any error
set -e

echo "Deploying from '$SRC_BRANCH' to '$DEPLOY_BRANCH'..."
read -r -p "Proceed? [y/N] " confirm
[[ $confirm =~ ^[yY](es)?$ ]] || { echo "Aborting."; exit 1; }

# Ensure clean working directory
if ! git diff-index --quiet HEAD --; then
    echo "You have uncommitted changes. Please commit them first."
    exit 1
fi

# Build the site
bundle exec jekyll build

# Store current branch
CURRENT_BRANCH=$(git rev-parse --abbrev-ref HEAD)

# Work on a temporary deploy directory
TEMP_DIR=$(mktemp -d)

# Copy the built site to temp
cp -R _site/* "$TEMP_DIR"

# Switch to deploy branch and replace contents
git checkout $DEPLOY_BRANCH || git checkout -b $DEPLOY_BRANCH
git rm -rf . > /dev/null
cp -R "$TEMP_DIR"/* .
rm -rf "$TEMP_DIR"

# Commit and push
git add .
git commit -m "Deploy site from $SRC_BRANCH [skip ci]" || echo "No changes to commit"
git push origin $DEPLOY_BRANCH

# Return to original branch
git checkout "$CURRENT_BRANCH"

echo "✅ Deployed successfully!"
