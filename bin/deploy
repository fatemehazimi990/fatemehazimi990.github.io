#!/usr/bin/env bash

# Safe deploy to GitHub Pages without overwriting working directory
# Builds site and pushes output to gh-pages

set -e

SRC_BRANCH="source"
DEPLOY_BRANCH="gh-pages"
BUILD_DIR=$(mktemp -d)

echo "Deploying from '$SRC_BRANCH' to '$DEPLOY_BRANCH' using temp build dir: $BUILD_DIR"
read -r -p "Proceed? [y/N] " confirm
[[ $confirm =~ ^[yY](es)?$ ]] || { echo "Aborting."; exit 1; }

# Ensure clean working directory
if ! git diff-index --quiet HEAD --; then
  echo "Uncommitted changes found. Please commit or stash first."
  exit 1
fi

# Build site
bundle exec jekyll build --destination "$BUILD_DIR"

# Save current branch
CURRENT_BRANCH=$(git rev-parse --abbrev-ref HEAD)

# Switch to deploy branch
git fetch origin
git checkout "$DEPLOY_BRANCH" || git checkout -b "$DEPLOY_BRANCH"

# Clean existing contents
git rm -rf . > /dev/null || true

# Copy built site into repo
cp -r "$BUILD_DIR"/* .

# Add and commit
git add .
git commit -m "Deploy from $SRC_BRANCH [skip ci]" || echo "Nothing new to commit"
git push origin "$DEPLOY_BRANCH"

# Cleanup and return
rm -rf "$BUILD_DIR"
git checkout "$CURRENT_BRANCH"

echo "✅ Deployed successfully!"
